+// limiterKey identifies the restrictions configured for a service tier. The
+// price is deliberately not part of it: a dynamic-price service mints at
+// whatever price its pricer quotes, and a static service without a price only
+// gets its default price after the limiter is built.
+type limiterKey struct {
+	name string
+	tier l402.ServiceTier
+}
+
+// limiterKeyFor returns the key of the configured service that minted tokens
+// for the given service. Dynamic-price tokens are named after the service
+// followed by the request path (see proxy.Service.ResourceName), so the name
+// up to the first slash is the configured service.
+func limiterKeyFor(service l402.Service) limiterKey {
+	name, _, _ := strings.Cut(service.Name, "/")
+
+	return limiterKey{name: name, tier: service.Tier}
 }
 
