@@ -0,0 +1,115 @@
+package aperture
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/lightninglabs/aperture/l402"
+	"github.com/lightninglabs/aperture/mint"
+	"github.com/lightninglabs/aperture/proxy"
+	"github.com/lightningnetwork/lnd/lntypes"
+	"github.com/stretchr/testify/require"
+)
+
+type priceTestChallenger struct{}
+
+func (priceTestChallenger) NewChallenge(int64) (string, lntypes.Hash, error) {
+	return "lnsb1...", lntypes.Hash{1}, nil
+}
+func (priceTestChallenger) Stop() {}
+
+type priceTestSecrets struct{}
+
+func (priceTestSecrets) NewSecret(context.Context,
+	[sha256.Size]byte) ([l402.SecretSize]byte, error) {
+
+	var s [l402.SecretSize]byte
+	_, err := rand.Read(s[:])
+	return s, err
+}
+func (priceTestSecrets) GetSecret(context.Context,
+	[sha256.Size]byte) ([l402.SecretSize]byte, error) {
+
+	return [l402.SecretSize]byte{}, mint.ErrSecretNotFound
+}
+func (priceTestSecrets) RevokeSecret(context.Context, [sha256.Size]byte) error {
+	return nil
+}
+
+// mintedConditions mints an L402 for svc at mintPrice through the real Mint
+// and returns the caveat conditions on the resulting macaroon.
+func mintedConditions(t *testing.T, svc *proxy.Service, mintName string,
+	mintPrice int64) []string {
+
+	m := mint.New(&mint.Config{
+		Challenger:     priceTestChallenger{},
+		Secrets:        priceTestSecrets{},
+		ServiceLimiter: newStaticServiceLimiter([]*proxy.Service{svc}),
+	})
+	mac, _, err := m.MintL402(context.Background(), l402.Service{
+		Name: mintName, Tier: l402.BaseTier, Price: mintPrice,
+	})
+	require.NoError(t, err)
+
+	var conds []string
+	for _, c := range mac.Caveats() {
+		conds = append(conds, strings.SplitN(string(c.Id), "=", 2)[0])
+	}
+	sort.Strings(conds)
+	return conds
+}
+
+// TestLimiterCaveatsWhenMintPriceDiffers shows that every limiter-backed
+// caveat is dropped when the price passed to MintL402 differs from the
+// service's configured price, as happens with dynamicprice.
+func TestLimiterCaveatsWhenMintPriceDiffers(t *testing.T) {
+	newSvc := func(price int64, dynamic bool) *proxy.Service {
+		s := &proxy.Service{
+			Name:         "svc",
+			Price:        price,
+			Timeout:      3600,
+			Capabilities: "read",
+			Constraints:  map[string]string{"svc_region": "us"},
+		}
+		s.DynamicPrice.Enabled = dynamic
+		return s
+	}
+	// proxy.Service.ResourceName names dynamic-price tokens
+	// "<service><path>"; static ones are named after the service.
+	const dynName = "svc/v1/x"
+	cases := []struct {
+		name      string
+		svc       *proxy.Service
+		mintName  string
+		mintPrice int64
+	}{
+		{"static, same price", newSvc(100, false), "svc", 100},
+		{"static, no price (default 1)", newSvc(0, false), "svc", 1},
+		{"dynamic, same price", newSvc(100, true), dynName, 100},
+		{"dynamic, quoted 25, no static", newSvc(0, true), dynName, 25},
+		{"dynamic, quoted 25, static 100", newSvc(100, true), dynName, 25},
+	}
+	for _, tc := range cases {
+		valid := "svc_valid_until"
+		if tc.svc.DynamicPrice.Enabled {
+			valid = dynName + "_valid_until"
+		}
+		want := []string{
+			"services", "svc_capabilities", "svc_region", valid,
+		}
+		sort.Strings(want)
+		got := mintedConditions(t, tc.svc, tc.mintName, tc.mintPrice)
+		t.Logf("%-32s caveats=%v", tc.name, got)
+		if !equalStrings(want, got) {
+			t.Errorf("%s: want %v, got %v", tc.name, want, got)
+		}
+	}
+}
+
+func equalStrings(a, b []string) bool {
+	return strings.Join(a, ",") == strings.Join(b, ",")
+}
