+
+// TestSessionActorIncomingAckStaysLocal prevents persistence-only ack payloads
+// from entering the protobuf transport, which has no IncomingAck RPC.
+func TestSessionActorIncomingAckStaysLocal(t *testing.T) {
+	t.Parallel()
+
+	ctx := t.Context()
+	sid := oorSessionID(0x72)
+	session, err := newReceiveSessionWithState(
+		ctx, sid, &ReceiveAwaitingAck{SessionID: sid}, EnvConfig{},
+	)
+	require.NoError(t, err)
+
+	b := &sessionBehavior{
+		cfg:       SessionActorConfig{ServerConn: &recordingServerConnRef{}},
+		actorID:   ActorIDForSession(sid),
+		log:       btclog.Disabled,
+		sessionID: sid,
+		direction: clientdb.OORSessionDirectionIncoming,
+		fsm:       session.FSM,
+		loaded:    true,
+	}
+	t.Cleanup(b.stopFSM)
+
+	require.NoError(t, b.driveOutbox(ctx, []OutboxEvent{
+		&SendIncomingAckRequest{SessionID: sid},
+	}))
+	require.Empty(t, b.pendingTransport)
+	state, err := b.fsm.CurrentState()
+	require.NoError(t, err)
+	require.IsType(t, &ReceiveCompleted{}, state)
+}
